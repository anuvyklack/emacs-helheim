;;; Tempel templates  -*- mode: lisp-data -*-
;;
;; Put your `tempel' snippets here.
;;
;; A bare major mode name opens a section; every list after it is one
;; template, named by its first element. Syntax, in short:
;;
;;   p     a field you fill in
;;   r     the active region, or a field when no region is active
;;   n     newline
;;   >     indent this line
;;   n>    newline and indent
;;   q     a field that finishes the template when you jump to it
;;
;; Any Lisp form returning a string is inserted and re-evaluated as you
;; edit the other fields. For full syntax see the Tempel README.

emacs-lisp-mode

(let "(let (" p ")" n> r> ")")
(let* "(let* (" p ")" n> r> ")")

markdown-mode

(gitcollapse & "## " (p "Heading") n n "<details>" n n
             "<summary>" (p "Sub Heading")  "</summary>" n n
             (r "Insert Link or comments") n n "</details>")

prog-mode

(fixme (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "FIXME ")
(todo (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "TODO ")
(bug (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "BUG ")
(hack (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "HACK ")

sh-base-mode

(! & "#!/usr/bin/env bash" n q)

text-mode

(box "┌─" (make-string (length str) ?─) "─┐" n
     "│ " (s str)                       " │" n
     "└─" (make-string (length str) ?─) "─┘" n)
(abox "+-" (make-string (length str) ?-) "-+" n
      "| " (s str)                       " |" n
      "+-" (make-string (length str) ?-) "-+" n)
